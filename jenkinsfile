pipeline {

    agent any 

    environment {

        IMAGE_NAME = "myapp"
        IMAGE_TAG = "v1.${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm
            }
        }

        stage ('unit test') {

            steps {

                sh 'mvn test'
            }
        }
        
        stage ('Integration test') {

            steps {

                sh 'mvn verify -DskipTests -B'
            }
        }

        stage ('Build') {

            steps {

                sh 'mvn clean install -B'
            }
        }
        
         stage ('Docker Image') {

            steps {

                sh '''

                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} . 

                docker tag ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:${IMAGE_TAG} 

                docker tag ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:latest
                
                '''

            }
        }

        stage ('Docker Push') {

            steps {

                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', passwordVariable: 'DockerPass', usernameVariable: 'DockerName')]) {
                
                sh '''

                echo ${DockerPass} | docker login -u ${DockerName} --password-stdin

                docker push  neeraj91/${IMAGE_NAME}:${IMAGE_TAG} 

                docker push  neeraj91/${IMAGE_NAME}:latest

                '''
                
                }
            }
        }

       stage('Deploy to Tomcat') {
            
            steps {
        
                withCredentials([usernamePassword(credentialsId: 'tomcat-credentials', passwordVariable: 'TOMCAT_PASS', usernameVariable: 'TOMCAT_USER')]) {
                
                sh '''
                WAR=$(ls target/*.war | head -n 1)
                curl -f -u "$TOMCAT_USER:$TOMCAT_PASS" -T "$WAR" \
                "http://tomcat:8080/manager/text/deploy?path=/myapp&update=true"
             
                '''
               }
            }
        }
    }
}